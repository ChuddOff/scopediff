{
  "name": "Создание, изменение и удаление услуг и заказов со снимком услуги",
  "clients": { "owner": {} },
  "steps": [
    { "client": "owner", "tap": "tab-services", "expect": { "node": "import-services" } },
    { "client": "owner", "tap": "new-service" },
    { "client": "owner", "tap": "method-manual" },
    { "client": "owner", "tap": "save-service", "expect": { "text": "Заполните поле «Название»." } },
    { "client": "owner", "type": "service-name", "text": "Дизайн витрины" },
    { "client": "owner", "type": "service-description", "text": "Два варианта и один раунд правок." },
    { "client": "owner", "tap": "save-service", "expect": { "screen": "service-detail", "text": "Два варианта и один раунд правок." } },
    { "client": "owner", "tap": "order-from-service", "expect": { "screen": "create-order", "text": "Дизайн витрины" } },
    { "client": "owner", "tap": "method-manual", "expect": { "screen": "order-form", "text": "Дизайн витрины" } },
    { "client": "owner", "type": "order-title", "text": "Оформление витрины" },
    { "client": "owner", "type": "order-agreements", "text": "Подготовить два варианта макета." },
    { "client": "owner", "tap": "save-order", "expect": { "screen": "order-detail", "text": "Дизайн витрины", "notText": "Срок ·" } },
    { "client": "owner", "tap": "back", "expect": { "screen": "service-detail" } },
    { "client": "owner", "tap": "edit-service", "expect": { "screen": "service-form", "value": { "target": "service-name", "equals": "Дизайн витрины" } } },
    { "client": "owner", "type": "service-name", "text": "Дизайн витрины для магазинов" },
    { "client": "owner", "tap": "save-service", "expect": { "screen": "service-detail", "text": "Дизайн витрины для магазинов" } },
    { "client": "owner", "tap": "delete-service", "expect": { "text": "Удалить услугу?" } },
    { "client": "owner", "tap": "cancel-delete", "expect": { "screen": "service-detail" } },
    { "client": "owner", "tap": "delete-service" },
    { "client": "owner", "tap": "confirm-delete", "expect": { "node": "import-services", "notText": "Дизайн витрины для магазинов" } },
    { "restart": "owner" },
    { "client": "owner", "tap": "Оформление витрины", "expect": { "screen": "order-detail", "text": "Дизайн витрины" } },
    { "client": "owner", "tap": "edit-order", "expect": { "screen": "order-form", "text": "Дизайн витрины" } },
    { "client": "owner", "type": "order-completed-work", "text": "Отправлены эскизы." },
    { "client": "owner", "tap": "save-order", "expect": { "screen": "order-detail", "text": "Отправлены эскизы." } },
    { "client": "owner", "tap": "order-menu", "expect": { "text": "Действия с заказом" } },
    { "client": "owner", "tap": "toggle-order-status", "expect": { "text": "Завершён", "notText": "Добавить правки" } },
    { "client": "owner", "tap": "back", "expect": { "node": "filter-completed", "text": "3 в работе" } },
    { "client": "owner", "tap": "filter-completed", "expect": { "text": "Оформление витрины" } },
    { "client": "owner", "tap": "Оформление витрины" },
    { "client": "owner", "tap": "order-menu" },
    { "client": "owner", "tap": "toggle-order-status", "expect": { "text": "В работе", "node": "add-changes" } },
    { "client": "owner", "tap": "order-menu" },
    { "client": "owner", "tap": "delete-order", "expect": { "text": "Удалить заказ?" } },
    { "client": "owner", "tap": "confirm-delete", "expect": { "node": "filter-active" } },
    { "client": "owner", "tap": "filter-active", "expect": { "text": "3 в работе", "notText": "Оформление витрины" } }
  ]
}
