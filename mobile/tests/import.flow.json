{
  "name": "Импорт услуг и заказов, черновик и повторная попытка",
  "steps": [
    { "tap": "tab-services" },
    { "tap": "import-services" },
    { "tap": "method-voice", "expect": { "screen": "import-service-voice", "text": "Демонстрационный режим" } },
    { "expect": { "notNode": "pick-screenshots", "text": "Введите текст вручную." } },
    { "tap": "submit-ai", "expect": { "text": "Добавьте текст или хотя бы один скриншот." } },
    { "type": "ai-text", "text": "Дизайн баннеров — Три формата.\nВёрстка рассылки — Один макет." },
    { "tap": "submit-ai", "expect": { "text": "Вёрстка рассылки", "node": "import-services" } },
    { "tap": "Дизайн баннеров", "expect": { "screen": "service-detail", "text": "Три формата." } },
    { "tap": "order-from-service" },
    { "tap": "method-screenshots", "expect": { "screen": "import-order-screenshots", "text": "Дизайн баннеров" } },
    { "tap": "pick-screenshots", "pick": [{ "name": "переписка.png", "width": 400, "height": 300 }, { "name": "пожелания.png", "width": 300, "height": 300 }], "expect": { "text": "пожелания.png" } },
    { "tap": "remove-screenshot-2", "expect": { "notText": "пожелания.png", "text": "переписка.png" } },
    { "tap": "submit-ai", "expect": { "screen": "order-detail", "text": "Черновик · Версия 1" } },
    { "expect": { "node": "order-changes", "notNode": "add-changes" } },
    { "tap": "order-menu" },
    { "tap": "toggle-order-status", "expect": { "text": "Чтобы завершить заказ, сначала закройте открытое предложение." } },
    { "tap": "close-order-menu" },
    { "tap": "order-changes", "expect": { "screen": "proposal", "node": "revise-by-voice" } },
    { "tap": "revise-by-voice", "expect": { "screen": "change-input", "notNode": "pick-screenshots" } },
    { "tap": "back" },
    { "tap": "proposal-menu" },
    { "tap": "proposal-revise", "expect": { "screen": "change-methods", "text": "Изменить правки" } },
    { "tap": "method-text", "expect": { "screen": "change-input" } },
    { "type": "ai-text", "text": "Сделать отдельный макет для мобильных." },
    { "tap": "submit-ai", "expect": { "screen": "proposal", "text": "Версия 2" } },
    { "tap": "revise-by-voice", "expect": { "screen": "change-input", "text": "Введите текст вручную." } },
    { "type": "ai-text", "text": "Убери второй пункт, за первый поставь полторы тысячи, добавь анимацию." },
    { "tap": "submit-ai", "expect": { "screen": "proposal", "text": "Версия 3", "notText": "Сделать отдельный макет для мобильных" } },
    { "expect": { "text": "Добавить анимацию" } },
    { "expect": { "text": "1 500 ₽" } },
    { "tap": "back", "expect": { "screen": "order-detail", "text": "Черновик · Версия 3" } },
    { "tap": "back", "expect": { "screen": "service-detail" } },
    { "tap": "back", "expect": { "node": "import-services" } },
    { "tap": "import-services" },
    { "tap": "method-screenshots", "expect": { "screen": "import-service-screenshots" } },
    { "tap": "pick-screenshots", "pick": { "name": "услуги.txt", "text": "Описание услуг" } },
    { "tap": "submit-ai", "expect": { "text": "Выберите изображения в формате PNG, JPEG или WebP." } },
    { "tap": "pick-screenshots", "pick": { "name": "услуги.png", "width": 400, "height": 300 } },
    { "tap": "submit-ai", "expect": { "text": "Дизайн рассылки", "node": "import-services" } },
    { "tap": "tab-orders", "expect": { "text": "4 в работе" } },
    { "tap": "new-order" },
    { "tap": "method-voice" },
    { "type": "ai-text", "text": "Заказ: Обложка для каталога\nДоговорённости: Один макет" },
    { "tap": "submit-ai", "expect": { "screen": "order-detail", "text": "Правок пока нет", "notText": "Версия 1" } },
    { "tap": "add-changes", "expect": { "screen": "change-methods", "text": "Создать правки" } },
    { "tap": "method-text", "expect": { "screen": "change-input" } },
    { "type": "ai-text", "text": "Подготовить второй вариант обложки." },
    { "tap": "submit-ai", "expect": { "screen": "proposal", "text": "Версия 1", "node": "proposal-document" } }
  ]
}
