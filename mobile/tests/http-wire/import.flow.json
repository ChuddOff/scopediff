{
  "name": "Нативный HTTP, повторная отправка AI, обновление предложения и конфликт версии",
  "steps": [
    { "tap": "tab-services", "expect": { "text": "Загрузка…" } },
    { "expect": { "text": "Услуга HTTP" } },
    { "tap": "service-wire-service", "expect": { "screen": "service-detail" } },
    { "tap": "order-from-service" },
    { "tap": "method-screenshots", "expect": { "screen": "import-order-screenshots", "text": "Перед отправкой в AI", "notNode": "ai-example" } },
    { "type": "ai-text", "text": "Согласовали формат" },
    { "tap": "pick-screenshots", "pick": [{ "name": "one.png", "width": 24, "height": 24 }, { "name": "two.png", "width": 32, "height": 32 }] },
    { "tap": "submit-ai", "expect": { "text": "Тестовый сбой обработки AI.", "value": { "target": "ai-text", "equals": "Согласовали формат" } } },
    { "expect": { "text": "two.png" } },
    { "tap": "submit-ai", "expect": { "screen": "order-detail", "text": "Заказ HTTP" } },
    { "tap": "edit-order", "expect": { "notNode": "order-completed-work", "text": "4 декабря 2026" } },
    { "tap": "clear-deadline", "expect": { "text": "Выбрать дату" } },
    { "type": "order-agreements", "text": "Уточнили описание" },
    { "tap": "save-order", "expect": { "screen": "order-detail", "text": "Уточнили описание", "notText": "Срок ·" } },
    { "tap": "order-menu" },
    { "expect": { "notNode": "refresh-order", "text": "Действия с заказом" } },
    { "tap": "close-order-menu" },
    { "tap": "add-changes", "expect": { "screen": "change-methods" } },
    { "tap": "method-text" },
    { "type": "ai-text", "text": "Новый макет" },
    { "tap": "submit-ai", "expect": { "screen": "proposal", "text": "Черновик" } },
    { "tap": "prepare-proposal", "expect": { "text": "На согласовании" } },
    { "tap": "proposal-menu", "expect": { "notNode": "demo-counter" } },
    { "tap": "refresh-proposal", "expect": { "text": "Встречные условия заказчика" } },
    { "expect": { "text": "Версия 2" } },
    { "tap": "proposal-menu" },
    { "tap": "proposal-revise" },
    { "tap": "method-text" },
    { "type": "ai-text", "text": "Уточнить сроки" },
    { "tap": "submit-ai", "expect": { "text": "Тестовый конфликт версии.", "value": { "target": "ai-text", "equals": "Уточнить сроки" } } },
    { "tap": "submit-ai", "expect": { "screen": "order-detail", "text": "Заказчик предложил изменения · Версия 2" } },
    { "tap": "back", "expect": { "screen": "change-input", "value": { "target": "ai-text", "equals": "Уточнить сроки" } } }
  ]
}
