{
  "name": "Предложение от услуги до согласования и восстановления после перезапуска",
  "clients": { "owner": {} },
  "steps": [
    { "client": "owner", "tap": "tab-services" },
    { "client": "owner", "tap": "new-service" },
    { "client": "owner", "tap": "method-manual" },
    { "client": "owner", "type": "service-name", "text": "Дизайн афиш" },
    { "client": "owner", "type": "service-description", "text": "Приватное описание услуги" },
    { "client": "owner", "tap": "save-service", "expect": { "screen": "service-detail" } },
    { "client": "owner", "tap": "order-from-service" },
    { "client": "owner", "tap": "method-manual", "expect": { "text": "Дизайн афиш" } },
    { "client": "owner", "type": "order-title", "text": "Афиша выставки" },
    { "client": "owner", "type": "order-agreements", "text": "Одна афиша для печати" },
    { "client": "owner", "tap": "save-order", "expect": { "screen": "order-detail" } },
    { "client": "owner", "tap": "add-changes", "expect": { "screen": "change-methods", "node": "method-voice" } },
    { "client": "owner", "tap": "method-text", "expect": { "screen": "change-input" } },
    { "client": "owner", "type": "ai-text", "text": "Электронная афиша — Адаптировать макет для рассылки.\nАфиша для сайта" },
    { "client": "owner", "tap": "submit-ai", "expect": { "screen": "proposal", "text": "Итоговая доплата не определена", "node": "proposal-document" } },
    { "client": "owner", "tap": "reason-1", "expect": { "text": "Требуется уточнить условия работы." } },
    { "client": "owner", "tap": "edit-proposal", "expect": { "screen": "proposal-editor" } },
    { "client": "owner", "tap": "work-category-1" },
    { "client": "owner", "tap": "category-extra", "expect": { "text": "Дополнительная работа" } },
    { "client": "owner", "type": "work-price-1", "text": "500", "expect": { "text": "Известная доплата · 500 ₽" } },
    { "client": "owner", "type": "work-price-2", "text": "0", "expect": { "text": "Итоговая доплата · 500 ₽" } },
    { "client": "owner", "tap": "save-proposal", "expect": { "screen": "proposal", "text": "0 ₽" } },
    { "client": "owner", "expect": { "text": "Версия 1" } },
    { "client": "owner", "tap": "share-proposal" },
    { "client": "owner", "expect": { "notNode": "share-pdf" } },
    { "client": "owner", "expect": { "notNode": "share-link" } },
    { "client": "owner", "tap": "share-markdown", "expect": { "screen": "proposal-export", "text": "### 1. Электронная афиша", "notText": "Одна афиша для печати" } },
    { "client": "owner", "expect": { "notText": "Требуется уточнить условия работы" } },
    { "client": "owner", "tap": "export-plain-view", "expect": { "text": "Итоговая доплата: 500 ₽", "notText": "### 1." } },
    { "client": "owner", "tap": "copy-export", "expect": { "toast": "Текст скопирован" } },
    { "client": "owner", "tap": "back", "expect": { "screen": "proposal", "text": "На согласовании" } },
    { "client": "owner", "tap": "proposal-menu" },
    { "client": "owner", "tap": "proposal-revise", "expect": { "screen": "change-methods", "text": "Изменить правки" } },
    { "client": "owner", "tap": "method-text" },
    { "client": "owner", "type": "ai-text", "text": "Убрать: Афиша для сайта\nАфиша для сторис\nЦена: Электронная афиша — 700\nСрок: 2026-12-10\nУсловия: Согласование макета перед передачей" },
    { "client": "owner", "tap": "submit-ai", "expect": { "screen": "proposal", "text": "Версия 2" } },
    { "client": "owner", "tap": "proposal-menu" },
    { "client": "owner", "tap": "compare-versions", "expect": { "screen": "proposal-diff", "text": "Добавленные работы" } },
    { "client": "owner", "expect": { "text": "Удалённые работы" } },
    { "client": "owner", "expect": { "text": "Стало · 700 ₽" } },
    { "client": "owner", "expect": { "text": "Стало · 10 декабря 2026" } },
    { "client": "owner", "tap": "back" },
    { "client": "owner", "tap": "proposal-menu" },
    { "client": "owner", "tap": "open-history", "expect": { "screen": "proposal-history", "text": "Исполнитель" } },
    { "client": "owner", "tap": "history-version-1", "expect": { "screen": "proposal-version", "text": "500 ₽", "notNode": "edit-proposal" } },
    { "client": "owner", "expect": { "notText": "Афиша для сторис" } },
    { "client": "owner", "tap": "back" },
    { "client": "owner", "tap": "back" },
    { "client": "owner", "tap": "prepare-proposal", "expect": { "text": "На согласовании" } },
    { "client": "owner", "tap": "approve-proposal" },
    { "client": "owner", "tap": "confirm-proposal-action", "expect": { "screen": "proposal", "text": "Согласовано", "notNode": "edit-proposal" } },
    { "client": "owner", "tap": "back", "expect": { "screen": "order-detail", "node": "order-changes", "notNode": "add-changes" } },
    { "client": "owner", "expect": { "text": "Одна афиша для печати" } },
    { "client": "owner", "expect": { "text": "Срок · 10 декабря 2026" } },
    { "restart": "owner" },
    { "client": "owner", "tap": "Афиша выставки", "expect": { "screen": "order-detail", "text": "Согласовано · Версия 2" } },
    { "client": "owner", "tap": "order-changes" },
    { "client": "owner", "tap": "next-round" },
    { "client": "owner", "tap": "method-text" },
    { "client": "owner", "type": "ai-text", "text": "Афиша для сторис" },
    { "client": "owner", "tap": "submit-ai", "expect": { "screen": "proposal", "text": "В рамках договорённостей" } },
    { "client": "owner", "tap": "reason-1", "expect": { "text": "Эта работа уже указана в согласованных правках.", "notText": "700 ₽" } },
    { "client": "owner", "tap": "proposal-menu" },
    { "client": "owner", "tap": "open-history", "expect": { "text": "Раунд 1 · Согласовано" } },
    { "client": "owner", "tap": "history-round-1-version-2", "expect": { "screen": "proposal-version", "text": "700 ₽", "notNode": "edit-proposal" } },
    { "client": "owner", "tap": "back" },
    { "client": "owner", "tap": "back" },
    { "client": "owner", "tap": "back", "expect": { "screen": "order-detail", "node": "order-changes", "notNode": "add-changes", "notText": "Согласовано · Версия 2" } }
  ]
}
